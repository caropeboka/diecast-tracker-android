<?xml version="1.0" encoding="utf-8"?>
<!-- The weekly automatic backup to a folder on the phone and/or one file on Google Drive. Edit all three languages together. -->
<resources>
    <string name="auto_backup_title">自动备份</string>
    <string name="auto_backup_text">应用每周自动备份一次，关闭时也会进行。可选择手机上的文件夹、Google 云端硬盘上的副本，或两者都选：只有手机以外的副本能在手机丢失时派上用场。</string>
    <string name="auto_backup_switch">每周备份</string>
    <string name="auto_backup_folder">手机上的文件夹</string>
    <string name="auto_backup_folder_hint">文件夹中保留最近三份自动备份。更早的自动备份会被删除，手动保存的备份不会。选择时可在“文档”中新建一个文件夹，例如“Diecast Tracker”。</string>
    <string name="auto_backup_pick_folder">选择文件夹</string>
    <string name="auto_backup_copy">Google 云端硬盘副本</string>
    <string name="auto_backup_copy_hint">Android 不允许应用访问云端硬盘的文件夹，因此每周覆盖同一个文件。保存时请打开左上角的 ☰ 菜单并选择云端硬盘：保存界面会先打开上次使用的文件夹（手机以外的其他位置也可以）。</string>
    <string name="auto_backup_on_phone">在本机</string>
    <string name="auto_backup_google_drive">Google 云端硬盘</string>
    <string name="auto_backup_copy_on_phone">此副本也在手机上，手机丢失时帮不上忙。请重新选择保存位置，并在 ☰ 菜单中选择云端硬盘。</string>
    <string name="auto_backup_pick_copy">选择保存位置</string>
    <string name="auto_backup_not_chosen">未选择</string>
    <string name="auto_backup_change">更改</string>
    <string name="auto_backup_remove">移除</string>
    <string name="auto_backup_last">上次自动备份：%1$s。</string>
    <string name="auto_backup_never">尚无自动备份。</string>
    <string name="auto_backup_failed">上次尝试失败：</string>
    <string name="auto_backup_now">立即备份</string>
    <string name="auto_backup_copying">正在把备份复制到所选位置…</string>
    <string name="auto_backup_folder_failed">文件夹：%1$s</string>
    <string name="auto_backup_copy_failed">副本：%1$s</string>
    <string name="auto_backup_folder_gone">无法再打开该文件夹，请重新选择。</string>
    <string name="auto_backup_copy_gone">无法再写入该文件，请重新选择。</string>
    <string name="auto_backup_cant_keep">该位置不允许应用以后再写入，请选择其他位置。</string>
    <string name="auto_backup_done">自动备份已写入。</string>
    <string name="auto_backup_nowhere">备份未能写入：请查看“自动备份”。</string>
    <string name="backup_reminder_failed">自动备份失败</string>
    <string name="backup_reminder_fix">去修复</string>
</resources>
